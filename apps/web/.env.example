# Leave this empty in production so the browser calls this site and Next.js proxies to the API.
# Set it only when the browser must call the API host directly.
NEXT_PUBLIC_API_URL=

# Server-side proxy target. Production API is the Render service.
# Use http://localhost:4000 when the API is running on this machine.
API_PROXY_URL=https://ricoz-healthcare-brokerage.onrender.com
