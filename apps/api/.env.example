# Copy this file to apps/api/.env and fill in the private values.
# Never commit apps/api/.env.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricoz_healthcare?retryWrites=true&w=majority
JWT_SECRET=<at-least-32-random-characters>
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Optional. Used only by `npm run user:create`, never by the public API.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
