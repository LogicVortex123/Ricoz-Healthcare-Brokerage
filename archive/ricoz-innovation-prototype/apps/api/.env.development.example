NODE_ENV=development
DEV_SIMPLE_AUTH=true
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare_transitions_dev?replicaSet=rs0
PORT=4000
WEB_ORIGIN=http://localhost:3000
PRIVATE_STORAGE_PATH=.private-storage
DEV_EMAIL_OUTBOX=true
DEV_SCANNER=synthetic
ALLOW_DEMO_SEED=true
# Synthetic local acceptance only; replace after legal review for real workflows.
NDA_VERSION=development-v1
NDA_TEXT="DEVELOPMENT ONLY. Fictional confidentiality agreement for synthetic test data. Not legally reviewed; electronic acceptance is not validated e-signature."
# Leave unset for direct localhost use. Set only to the actual trusted proxy hop count.
# TRUST_PROXY_HOPS=1

# Optional in development: otherwise a private .dev-jwt-secret is generated.
# JWT_SECRET=use-a-random-secret-at-least-32-bytes-long

